DATABASE_URL="postgresql://donpimenton:donpimenton@localhost:5432/donpimenton?schema=public"
PORT=4000
SESSION_TTL_HOURS=8
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_DEPLOYMENT_FILE=../blockchain/deployments/localhost.json
CHAIN_ARTIFACTS_DIR=../blockchain/artifacts/contracts
UPLOAD_DIR=./uploads

# URL pública (QR de trazabilidad, retorno de pasarelas de pago)
PUBLIC_BASE_URL=http://localhost:3000

# --- Asistente de IA (opcional). Sin clave funciona en modo base de conocimiento local.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Pagos (opcional). Con claves de prueba (sk_test_, TEST-) los cobros son de prueba; con claves productivas son REALES.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MP_ACCESS_TOKEN=TEST-...
# YAPE_NUMBER=9XXXXXXXX
# YAPE_HOLDER=
# YAPE_QR_URL=
# BANK_NAME=
# BANK_HOLDER=
# BANK_ACCOUNT=
# BANK_CCI=
# BANK_SWIFT=
# PAYMENTS_ALLOW_TEST=true   # "false" oculta el pago de prueba en producción

# --- Motor de automatización del smart contract ("off" para desactivarlo)
# AUTOMATION=on
